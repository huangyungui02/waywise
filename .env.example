# 必填：启动时自动创建初始用户；同名用户已存在时保留原密码。
INITIAL_USERNAME=admin
INITIAL_PASSWORD=

# 必填：JWT 签名密钥，通过 openssl rand -hex 32 生成，至少 32 个字符。
JWT_SECRET_KEY=
# 生产部署使用的域名，需解析到服务器；本地开发不使用。
DOMAIN=travel.example.com

# 百炼模型 ID；通过 OpenAI Responses 接口启用内置 web_search。
TRAVEL_MODEL=qwen3.8-flash
DASHSCOPE_API_KEY=
# 北京按量计费兼容地址；也可改为控制台业务空间对应的 /compatible-mode/v1 地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：上下文估算超过此 Token 数时自动摘要，保留最近 12 条消息。
COMPACT_MAX_TOKENS=500000

# 高德开放平台 Web 服务 Key（必填）
AMAP_MAPS_API_KEY=

# 飞猪可试用；正式使用可选配置，也可使用 flyai config set。
FLYAI_API_KEY=

# Compose 自动覆盖为容器内连接地址；此值供宿主机工具连接本地开发数据库。
DATABASE_URL=postgresql://waywise:waywise@localhost:5432/waywise
# 可选：DBOS 默认使用 DATABASE_URL，在独立的 dbos schema 保存执行记录。
DBOS_DATABASE_URL=
# 已结束的 DBOS 执行历史保留天数，每小时清理；不影响聊天历史。
DBOS_RETENTION_DAYS=7
# 同时执行的会话数；超出后持久排队，同一会话不接受重复提交。
MAX_CONCURRENT_RUNS=4

# iOS App 跨域来源；业务 API 使用登录取得的 Bearer JWT，按用户隔离。
CORS_ORIGINS=["capacitor://localhost"]

# 可选：Logfire 项目的 Write Token；留空不启用遥测。
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=production
# 开启后会上传对话、模型回复及工具参数和结果；默认不采集这些正文。
LOGFIRE_INCLUDE_CONTENT=false
